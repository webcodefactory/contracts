{
    "name": "alumateria/contracts",
    "description": "Shared message and domain contracts for Alumateria microservices",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Alumateria\\Contracts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alumateria\\Contracts\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2",
        "monolog/monolog": "^3.0",
        "symfony/config": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/event-dispatcher": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/http-kernel": "^6.4",
        "symfony/messenger": "^6.4",
        "symfony/security-core": "^6.4"
    },
    "require-dev": {
        "doctrine/orm": "^3.0",
        "phpunit/phpunit": "^10.5",
        "predis/predis": "^2.0|^3.0"
    },
    "suggest": {
        "doctrine/orm": "Enables the tenant SQL filter safety net (Alumateria\\Contracts\\Tenant\\Doctrine)",
        "predis/predis": "Enables Host-based tenant domain resolution (Alumateria\\Contracts\\Tenant\\Domain)"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
